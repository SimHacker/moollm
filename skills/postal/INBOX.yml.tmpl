# INBOX.yml -- Message Collection Point
#
# Collects messages for an endpoint. Without an inbox, messages go to the
# endpoint's messages/ directory.

inbox:
  owner: "{{owner_path}}"          # REQUIRED: endpoint this inbox belongs to

  messages: []
  #   - ref: "messages/mom-quest.yml"
  #     received: "2026-01-10T10:00:00Z"
  #     read: false
  #     priority: high
  #     from: "characters/family/mom/"
  #     subject: "Find the Locket"
  #     preview: "Dearest, I need you to find..."

  unread_count: 0                  # COMPUTED
  total_count: 0                   # COMPUTED

  settings:
    max_messages: 100              # e.g. 10 for a room's notice board
    auto_delete_after: null        # "30 days", "never"
    forward_to: null               # Auto-forward to another endpoint
    notify_on_receive: true        # Emit an event on arrival
