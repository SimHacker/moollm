# TEXT.yml -- Instant Short Message
#
# Texts are short (under 160 chars recommended), carry at most a photo,
# and are delivered instantly instead of queued.

text:
  id: "{{text_id}}"                # REQUIRED

  from: "{{sender_path}}"          # REQUIRED: e.g. "characters/npcs/bartender/"
  to: "{{recipient_path}}"         # REQUIRED: e.g. "player", "party"

  body: "{{message}}"              # REQUIRED

  photo: null                      # OPTIONAL: { ref: "images/x.jpg" } or { generate: "prompt" }

  quick_replies: []                # OPTIONAL: suggested replies

  timestamp: null                  # COMPUTED
  read: false                      # COMPUTED

  delivery: instant                # instant | queued

  reply_to: null
  thread_id: null

# Example:
#
#   text:
#     id: text-001
#     from: "characters/npcs/bartender/"
#     to: player
#     body: "Hey, you left your hat here!"
#     quick_replies: ["On my way!", "Can you hold it?"]
