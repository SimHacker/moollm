# LETTER.yml -- Postal Message Primitive
#
# Letters are the narrative wrapper for goals, rewards, and communication.
# Addresses are paths or reserved keywords (player, party, narrator), never bare names.

letter:
  id: "{{letter_id}}"              # REQUIRED: Unique identifier

  from: "{{sender_path}}"          # REQUIRED: e.g. "characters/family/mom/"
  to: "{{recipient_path}}"         # REQUIRED: e.g. "player", "storage/vault/"
  subject: "{{subject}}"           # REQUIRED

  body: |                          # REQUIRED
    {{letter_body}}

  # Attachment types: object, gold, image, buff, room, message.
  # Actions: send, give, copy, reference, unlock, apply, generate, forward.
  attachments: []
  #   - type: object
  #     ref: brass-key
  #     action: send
  #   - type: room
  #     ref: home/attic/
  #     action: unlock

  # Any sender can create, modify, or complete goals.
  creates_goal: null
  #   id: find-locket
  #   name: "Find Grandmother's Locket"
  #   done_when: "player has family-locket"
  #   reward: { letter: mom-thanks-001 }

  modifies_goal: null
  #   id: find-locket
  #   extend_with: "also check the old chest"

  completes_goal: null
  #   id: find-locket
  #   success: true

  sent: null                       # COMPUTED
  received: null                   # COMPUTED
  read: false                      # COMPUTED
  replied: false                   # COMPUTED

  status: draft                    # draft | outbox | in_transit | delivered | read

