# MESSAGE.yml -- Mail Transport Primitive
#
# Messages move between any addressable endpoints: player, characters, rooms,
# objects, directories. They are YAML files that travel through the filesystem
# carrying attachments.
#
# Alan Kay, squeak-dev, 1998:
#   "The big idea is "messaging" -- that is what the kernal of Smalltalk/Squeak
#    is all about"

message:
  id: "{{message_id}}"             # REQUIRED

  from: "{{sender_path}}"          # REQUIRED: source endpoint
  to: "{{recipient_path}}"         # REQUIRED: destination endpoint, or a list
  subject: "{{subject}}"           # REQUIRED

  body: |                          # REQUIRED
    {{body_text}}

  # Types: object, gold, image, buff, room, message.
  # Actions: send, give, copy, reference, unlock, apply, generate, forward.
  attachments: []
  #   - type: gold
  #     quantity: 100
  #     action: send

  delivery:
    method: letter                 # text | letter | express | courier | freight | logistics
    base_time: 3                   # Turns for this method
    distance_hops: 0               # COMPUTED: hops through the room graph
    time_per_hop: 1
    total_time: 3                  # COMPUTED: base_time + distance_hops * time_per_hop
    turns_remaining: 3             # COMPUTED: decrements each tick

  postage:
    base_cost: 1                   # Gold for this method
    weight_cost: 0                 # Per kg of attachments
    distance_cost: 0               # Per hop
    total_cost: 1                  # COMPUTED
    paid: false
    paid_from: null                # Defaults to sender
    free_reason: null              # text | system | same_location

  created: null                    # COMPUTED
  sent: null                       # COMPUTED
  estimated_arrival: null          # COMPUTED: sent + total_time
  delivered: null                  # COMPUTED
  read: null                       # COMPUTED

  status: draft                    # draft | outbox | in_transit | delivered | read
                                   # The outbox stage is optional.

  reply_to: null                   # Message ID this replies to
  thread_id: null
  priority: normal                 # low | normal | high | urgent

  flags:
    starred: false
    archived: false
    deleted: false                 # Soft delete

# Example: multi-recipient notice.
#
#   message:
#     id: msg-003
#     from: "characters/npcs/bartender/"
#     to: [player, "characters/real-people/don-hopkins/"]
#     subject: "Last call"
#     body: "The pub is closing in 10 minutes."
