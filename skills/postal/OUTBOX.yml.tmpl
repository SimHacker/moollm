# OUTBOX.yml -- Message Staging Area
#
# Optional. Stages drafts before sending; messages can also be sent directly.

outbox:
  owner: "{{owner_path}}"          # REQUIRED: endpoint this outbox belongs to

  drafts: []
  #   - ref: "messages/draft-001.yml"
  #     started: "2026-01-10T09:00:00Z"
  #     last_edited: "2026-01-10T09:30:00Z"
  #     to: "characters/family/mom/"
  #     subject: "Still writing..."

  pending: []                      # Ready to send; same entry shape plus queued:

  sent: []                         # Copies of sent messages, if save_copies

  drafts_count: 0                  # COMPUTED
  pending_count: 0                 # COMPUTED

  settings:
    auto_save: true
    save_copies: true
    default_priority: normal
