# GOAL.yml — a state of the world someone wants.
#
# A goal is a difference between how things are and how they should be (Minsky).
# Nobody claims a goal; it is satisfied when done_when holds. Work claimed to
# satisfy it is a task (skills/task inherits this skill). One step of that work,
# right now, is an action in an action-queue.
#
# Store what happened (history). Compute what is possible (state).

id: "{{id}}"                     # REQUIRED
name: "{{name}}"                 # REQUIRED: short display name
description: "{{description}}"   # REQUIRED: what the world looks like when it's done

done_when: "{{condition}}"       # REQUIRED: "player has the treasure"
done_when_js: null               # COMPILED
done_when_py: null               # COMPILED

fail_when: null                  # When the goal becomes impossible
fail_when_js: null               # COMPILED
fail_when_py: null               # COMPILED
fail_message: null

priority: normal                 # low | normal | high | urgent; an input to scoring

reward: null
#   reward:
#     buff: "Hero's Glory"
#     item: "champion-medal"
#     unlock: "secret-room"
#     narrative: "The kingdom celebrates your victory!"

parent: null                     # part of a larger goal
children: []                     # sub-goals; parent is done when all children are, unless done_when says more
requires: []                     # guards that must hold before the goal is active
blocks: []                       # mutually exclusive goals

progress: null
#   progress: { collected: 3, needed: 5 }

given_by: null                   # who or what set the goal
location: null                   # where it was given

history:                         # append-only: given, done, failed, cancelled, reopened
  - { event: given, by: "{{given_by}}" }
# state is computed, never stored:
#   failed   fail_when holds, or a failed event
#   done     done_when holds, confirmed by a done event
#   active   every requires guard holds
#   pending  otherwise

# EXAMPLES (flat; an embedded list of goals lives under a goals: key, each item a goal)
#
#   id: save-npc
#   name: "Save the Prisoner"
