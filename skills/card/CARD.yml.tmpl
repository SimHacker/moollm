# CARD.yml — {{name}}
#
# The one file a model reads to learn what this object does (constitution §15).
# Schema: skills/card/CARD.yml schema:. Fill {{placeholders}}; delete any key whose value
# would be its default. Object-specific YAML Jazz keys are welcome anywhere below.

# IDENTITY AND DUBLIN CORE

id: {{id}}                         # kebab-case; default: the directory name
name: "{{name}}"                   # default: the id, title case
type: skill                        # ONE id; other kinds go in tags:
tags: [{{tag}}]
description: |
  {{description}}
  Two to six sentences: what this is and why you would use it.

credits:                           # keyed by role; a bare list is one unnamed role
  origin: ["{{Person — work (year)}}"]

# CARD FACE

emoji: 🎯
tier: 2                            # 0 foundational/ambient, 1 core, 2 standard (default), 3 experimental
rarity: common                     # common (default) | uncommon | rare | epic | legendary | mythic
tagline: "{{tagline}}"             # default: first sentence of description

tools:
  required: [read_file]
  optional: [write_file, grep]

files:                             # what else to read when activated, most important first
  docs:
    - SKILL.md                     # Full protocol, method implementations
    - README.md                    # Human landing page
  examples:
    - examples/basic-usage.yml     # Start here

# ACTIVATION — words and concepts that wake this card; default: [{{ID}}]

k_lines: [{{K-LINE}}, {{RELATED-CONCEPT}}]

# BEHAVIOR — advertisements before methods: a model scans top-down to decide

advertisements:
  {{AD-NAME}}:                     # UPPER-DASHES
    score: 90                      # 0..100; default 50
    score_if: "{{situation that calls for this}}"   # prose an LLM judges; omit for always
    method: {{METHOD-NAME}}        # optional; default: the method with the same name

  {{ANOTHER-AD}}:
    score: 80
    score_if: ["{{situation}}", "{{another situation}}"]   # a list means any
    effect: "{{what happens when chosen}}"

methods:
  {{METHOD-NAME}}:                 # UPPER-DASHES for commands a player types; lowercase for functions
    signature: "{{METHOD-NAME}} [arg] (optional-arg)"
    description: "{{what it does}}"
    invoked_by: [player]           # default: [player, npc]

# COPY-DOWN — the most important slots and methods of this directory's interface files
# and of the skill's prototype file. Copied methods also appear in methods: with from:.

interfaces:
  {{INTERFACE}}.yml:
    role: prototype                # prototype | interface (default)
    slots: { {{key}}: "{{default and meaning}}" }
    methods: [{{METHOD}}]

# STATE — per-instance mutable state: field → default, or prose

state:
  {{field}}: {{default}}

# RELATIONS

inherits: []                       # parents, most specific first (SCHEMA.md § Parents)
related:
  - { id: {{other-skill}}, role: sibling, when: "{{when to go there instead}}" }
see_also:                          # default: SKILL.md and README.md
  - SKILL.md: ["§ {{Section}}"]
lineage:
  - { name: "{{Inspiration}}", year: {{year}}, note: "{{what it contributed}}" }

# COMMON JAZZ, ALIGNED NAMES

principles:
  {{principle-name}}: "{{the idea in one line}}"
anti_patterns:
  {{anti-pattern-name}}: "{{what not to do, and what to do instead}}"
